# MLOps observability stack — environment for `make mlops-up`
#
#   cp observability/.env.mlops.example observability/.env.mlops
# then `make mlops-up` (which auto-sources .env.mlops if present).
#
# When MLOPS_PREDICTION_LOG_DSN below is exported into the FastAPI app's
# environment, every /api/predict and /api/predict/batch call writes a
# row to prediction-log-postgres. When unset, the hook no-ops — the app
# behaves exactly as today.

# ─── Image pins ───
# Defaults below are chosen to match versions typically cached on dev
# machines from the rest of the portfolio's PoC stacks (LGTM, Sentry
# self-hosted, Langfuse) so first `make mlops-up` only pulls the
# Evidently + MLflow + Python images. Bump if you want newer.
MLFLOW_VERSION=v2.18.0
MLFLOW_POSTGRES_VERSION=14.22-bookworm
MLFLOW_MINIO_VERSION=RELEASE.2024-10-13T13-34-11Z
MLFLOW_MC_VERSION=RELEASE.2024-10-08T09-37-26Z
PREDICTION_LOG_POSTGRES_VERSION=14.22-bookworm
EVIDENTLY_VERSION=0.7.21

# ─── Host ports ───
# Picked to coexist with LGTM (13000), Langfuse (13100), Coroot (18080),
# Sentry self-hosted (9000), and Honeycomb refinery (8081).
MLFLOW_HOST_PORT=15000
EVIDENTLY_HOST_PORT=15001
PREDICTION_LOG_HOST_PORT=15432

# ─── Credentials (local-dev defaults; rotate for any non-localhost use) ───
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_MINIO_USER=mlflow
MLFLOW_MINIO_PASSWORD=mlflow-secret-pass
PREDICTION_LOG_USER=mlops
PREDICTION_LOG_PASSWORD=mlops
PREDICTION_LOG_DB=prediction_log

# ─── Memory limits (tuned for ~960 MiB total — see plan budget) ───
MLFLOW_SERVER_MEMORY_LIMIT=512m
MLFLOW_POSTGRES_MEMORY_LIMIT=256m
MLFLOW_MINIO_MEMORY_LIMIT=512m
PREDICTION_LOG_POSTGRES_MEMORY_LIMIT=256m
EVIDENTLY_UI_MEMORY_LIMIT=768m
EVIDENTLY_SCHEDULER_MEMORY_LIMIT=512m

# ─── FastAPI hook DSN (export this when running the app) ───
# Set this to enable prediction logging on the host-running FastAPI app:
#   export MLOPS_PREDICTION_LOG_DSN=postgresql://mlops:mlops@localhost:15432/prediction_log
#
# Inside the FastAPI Docker container, reach the published host port via
# host.docker.internal (already an extra_host on the app service):
#   MLOPS_PREDICTION_LOG_DSN=postgresql://mlops:mlops@host.docker.internal:15432/prediction_log
MLOPS_PREDICTION_LOG_DSN=

# ─── Training-side MLflow tracking URI ───
# Set before running training scripts to send experiments to the local
# server. When unset, MLflow falls back to ./mlruns/ next to the script
# CWD (gitignored).
#   export MLFLOW_TRACKING_URI=http://localhost:15000
MLFLOW_TRACKING_URI=

# ─── Evidently scheduler tunables ───
EVIDENTLY_PROJECT_NAME=tfg-polyp-detection
EVIDENTLY_REFERENCE_WINDOW_HOURS=72
EVIDENTLY_CURRENT_WINDOW_HOURS=1
EVIDENTLY_SCAN_INTERVAL_SECONDS=60
